Give `unix://` a `local-fs` setting, so it can read store objects over
the socket.

`UDSRemoteStore` is a `LocalFSStore`. It reads `.drv` files, NAR
contents and every `getFSAccessor` read from the client's own
/nix/store, and only writes go to the daemon. A daemon in a VM or a
container serves a store the client cannot see, so a push works and
every read fails with "No such file or directory" (measured on 2.35.2
for nixidae/nixidae#700).

`local-fs=false` sends those three reads to `RemoteStore`, which asks
the daemon, as `ssh-ng://` does. The default stays `true`, so a store
URL without the setting behaves as before. Nix already ships the
opposite pair: `mounted-ssh-ng://` is `ssh-ng://` plus the local reads.

nixidae/nixidae#1138. It is meant for upstream.

--- a/src/libstore/include/nix/store/uds-remote-store.hh
+++ b/src/libstore/include/nix/store/uds-remote-store.hh
@@ -49,6 +49,18 @@
      */
     std::filesystem::path path;

+    Setting<bool> localFS{
+        this,
+        true,
+        "local-fs",
+        R"(
+          Whether the client reads store objects from its own file system.
+          Set it to `false` when the daemon serves a store this machine
+          cannot see, such as one in a virtual machine or a container.
+          Then the client reads everything over the socket, as `ssh-ng://` does.
+        )",
+    };
+
     static StringSet uriSchemes()
     {
         return {"unix"};
@@ -73,16 +85,22 @@

     ref<SourceAccessor> getFSAccessor(bool requireValidPath = true) override
     {
+        if (!config->localFS)
+            return RemoteStore::getFSAccessor(requireValidPath);
         return LocalFSStore::getFSAccessor(requireValidPath);
     }

     std::shared_ptr<SourceAccessor> getFSAccessor(const StorePath & path, bool requireValidPath = true) override
     {
+        if (!config->localFS)
+            return RemoteStore::getFSAccessor(path, requireValidPath);
         return LocalFSStore::getFSAccessor(path, requireValidPath);
     }

     void narFromPath(const StorePath & path, Sink & sink) override
     {
+        if (!config->localFS)
+            return RemoteStore::narFromPath(path, sink);
         Store::narFromPath(path, sink);
     }

