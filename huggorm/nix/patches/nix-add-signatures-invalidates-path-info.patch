@@ -755,8 +755,9 @@
     WorkerProto::write(*this, *conn, storePath);
     WorkerProto::write(*this, *conn, sigs);
     conn.processStderr();
     readInt(conn->from);
+    invalidatePathInfoCacheFor(storePath);
 }

