+StringMap AbstractConfig::unknownSettingsWithPrefix(std::string_view prefix) const
+{
+    StringMap res;
+    for (const auto & [name, value] : unknownSettings)
+        if (hasPrefix(name, prefix))
+            res.emplace(name, value);
+    return res;
