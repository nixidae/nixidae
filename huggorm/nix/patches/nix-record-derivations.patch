     bool isDerivation(Value & v);
 
+    /**
+     * Start or stop recording each derivation this state turns into its
+     * `outPath`: by string coercion, as `"${drv}"` and `toString` do, or
+     * by `toJSON`. Off by default, so a state that does not ask pays one
+     * relaxed atomic load per coercion. Stopping keeps what is recorded.
+     *
+     * Only coercions after the start are recorded. A string that a
+     * coercion before it already made is not coerced again. Reading
+     * `drv.outPath` directly is no coercion, and is not recorded.
+     */
+    void setRecordDerivations(bool record);
+
+    /**
+     * Drop every recorded derivation, so the collector may free them.
+     */
+    void clearRecordedDerivations();
+
+    /**
+     * Called where a derivation `drv` is turned into `outPath`, its
+     * `outPath` attribute, at `pos`. Records the pair if recording is on
+     * and `outPath` is not recorded yet. It throws nothing that the
+     * caller's own force of `outPath` would not.
+     */
+    void noteDerivationOutPath(Value & drv, Value & outPath, const PosIdx pos);
+
+    /**
+     * The derivation recorded for `outPath`, or nullptr.
+     */
+    Value * recordedDerivation(std::string_view outPath);
+
+    /**
+     * Every `outPath` recorded, sorted.
+     */
+    std::vector<std::string> recordedOutPaths();
+
+private:
+
+    std::atomic<bool> recordingDerivations{false};
+    std::mutex recordedDerivationsMutex;
+    /**
+     * The values live in collector memory. The allocator makes the map's
+     * nodes a root, so a recorded derivation stays alive with the state.
+     */
+    std::map<std::string, Value *, std::less<>, traceable_allocator<std::pair<const std::string, Value *>>>
+        recordedDerivations;
+
