                 addCommonSSHOpts(args, socketPath);
-                if (verbosity >= lvlChatty)
+                if (sshVerbose())
                     args.push_back("-v");
                 args.splice(args.end(), std::move(extraSshArgs));
                 // Override LocalCommand to no-op on command SSHs; master
@@ -295,7 +302,7 @@
                 throw SysError("duping over stdout");
 
