+/**
+ * Slots move between a thread's own list and the shared one in batches
+ * of this many, so the shared lock is taken once per batch rather than
+ * once per root.
+ */
+constexpr size_t batchSize = 64;
 
 /* Head of the freelist of slots. Never destroyed since root values
    held by statics may be released after us during shutdown. */
-static auto & freeSlots = *new Sync<Slot *>{nullptr};
+auto & freeSlots = *new Sync<Slot *>{nullptr};
+
+/**
+ * This thread's free slots. Trivially destructible, so it is still
+ * readable while other thread-locals are destroyed at thread exit.
+ */
+struct LocalSlots
+{
+    Slot * head = nullptr;
+    size_t count = 0;
+    /* Set once this thread's slots went back to the shared list. */
+    bool closed = false;
+};
+
+thread_local LocalSlots localSlots;
+
+/** Moves up to `n` slots from the front of `local` to the shared list. */
+void spill(LocalSlots & local, size_t n)
+{
+    if (!local.head || n == 0)
+        return;
+    Slot * first = local.head;
+    Slot * last = first;
+    size_t moved = 1;
+    while (moved < n && last->nextFree) {
+        last = last->nextFree;
+        ++moved;
+    }
+    local.head = last->nextFree;
+    local.count -= moved;
+    auto head(freeSlots.lock());
+    last->nextFree = *head;
+    *head = first;
+}
+
+/**
+ * Gives this thread's slots back when it exits, so a thread pool that
+ * churns threads does not strand them.
+ */
+struct LocalFlush
+{
+    ~LocalFlush()
+    {
+        spill(localSlots, localSlots.count);
+        localSlots.closed = true;
+    }
+};
+
+thread_local LocalFlush localFlush;
+
+/** A new slab on the shared list, which must be empty. The caller
+    holds its lock. */
+void carve(Slot *& head)
+{
+    constexpr size_t slabSize = 4096;
+    auto slab = (Slot *) GC_MALLOC_UNCOLLECTABLE(slabSize * sizeof(Slot));
+    if (!slab)
+        outOfMemory();
+    for (size_t i = 0; i + 1 < slabSize; ++i)
+        slab[i].nextFree = &slab[i + 1];
+    slab[slabSize - 1].nextFree = nullptr;
+    head = slab;
+}
+
+/** Moves up to `batchSize` slots from the shared list to `local`. */
+void refill(LocalSlots & local)
+{
+    auto head(freeSlots.lock());
+    if (!*head)
+        carve(*head);
+    while (*head && local.count < batchSize) {
+        Slot * s = *head;
+        *head = s->nextFree;
+        s->nextFree = local.head;
+        local.head = s;
+        ++local.count;
+    }
+}
+} // namespace
 
 #endif
 
