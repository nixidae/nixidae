{
  "name": "npm-demo",
  "version": "0.1.0",
  "description": "TypeScript that esbuild compiles, over a CommonJS package with a nested dependency.",
  "bin": {
    "npm-demo": "dist/main.js"
  },
  "scripts": {
    "build": "esbuild src/main.ts --platform=node --format=cjs --outfile=dist/main.js --banner:js='#!/usr/bin/env node'"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "ansi-styles": "^6.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
