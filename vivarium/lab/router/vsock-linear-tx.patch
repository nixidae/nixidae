Lab only. Keep each TX packet small enough for a linear skb, so the
header and data reach the device in one descriptor. rust-vmm's
virtio-vsock (0.10 and 0.12) reads a packet's data from one descriptor,
and a nonlinear skb puts every fragment in its own.

--- a/net/vmw_vsock/virtio_transport_common.c
+++ b/net/vmw_vsock/virtio_transport_common.c
@@ -299,7 +299,7 @@
 static int virtio_transport_send_pkt_info(struct vsock_sock *vsk,
 					  struct virtio_vsock_pkt_info *info)
 {
-	u32 max_skb_len = VIRTIO_VSOCK_MAX_PKT_BUF_SIZE;
+	u32 max_skb_len = MAX_COLLAPSE_LEN;
 	u32 src_cid, src_port, dst_cid, dst_port;
 	const struct virtio_transport *t_ops;
 	struct virtio_vsock_sock *vvs;
