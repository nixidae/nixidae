// One run of `vivarium-runner run`, from the process start to the exit.
// Solid edges: "then". Dashed edges: "starts a task beside it".
digraph run {
  rankdir = TB;
  node [shape = box, style = rounded];

  main     [label = "main\nvivarium/cli.py", file = "pkgs/vivarium/vivarium/cli.py", symbol = "main"];
  enter    [label = "re-exec in a user and mount namespace\nnamespace.py: enter", file = "pkgs/vivarium/vivarium/namespace.py", symbol = "enter"];
  cleaner  [label = "cleaner: removes the run root\nwhen the runner dies\nrunroot.py: spawn_cleaner", file = "pkgs/vivarium/vivarium/runroot.py", symbol = "spawn_cleaner"];
  hold     [label = "lock --out\nliveness.py: hold", file = "pkgs/vivarium/vivarium/liveness.py", symbol = "hold"];
  run      [label = "Spec.read, Session, --only\nvivarium/cli.py: run", file = "pkgs/vivarium/vivarium/cli.py", symbol = "run"];
  signals  [label = "SIGTERM, SIGHUP, parent exit\n_stop_on_signal, _stop_with_parent", file = "pkgs/vivarium/vivarium/cli.py", symbol = "_stop_on_signal"];
  drive    [label = "drive", file = "pkgs/vivarium/vivarium/cli.py", symbol = "drive"];
  follow   [label = "guest journals to events\nSession.follow", file = "pkgs/vivarium/vivarium/session.py", symbol = "Session.follow"];
  control  [label = "control.sock\nController.serve", file = "pkgs/vivarium/vivarium/control.py", symbol = "Controller.serve"];
  remote   [label = "remote machine socket\nremote.py: serve", file = "pkgs/vivarium/vivarium/remote.py", symbol = "serve"];
  runjson  [label = "write run.json\ncontrol.py: run_file", file = "pkgs/vivarium/vivarium/control.py", symbol = "run_file"];
  live     [label = "background tasks of the run\nSession.live", file = "pkgs/vivarium/vivarium/session.py", symbol = "Session.live"];
  boot     [label = "segments, Machines, forwards; boot\nSession.boot", file = "pkgs/vivarium/vivarium/session.py", symbol = "Session.boot"];
  start    [label = "pause: before the first phase", file = "pkgs/vivarium/vivarium/control.py", symbol = "Controller.pause"];
  schedule [label = "run the phases\n_schedule", file = "pkgs/vivarium/vivarium/cli.py", symbol = "_schedule"];
  ready    [label = "--hold: pause at ready,\n_schedule again on continue", file = "pkgs/vivarium/vivarium/cli.py", symbol = "_sequence"];
  teardown [label = "shielded: drain, write_output,\nteardown, write_report, access.empty\n_sequence", file = "pkgs/vivarium/vivarium/cli.py", symbol = "_sequence"];
  exit     [label = "exit status\n0 passed, 1 failed, ...", file = "pkgs/vivarium/vivarium/exits.py", symbol = "Exit"];

  main -> enter;
  enter -> cleaner [style = dashed, label = "forks first"];
  enter -> hold [label = "inside the namespace"];
  hold -> run;
  run -> signals [style = dashed];
  run -> drive;
  drive -> follow [style = dashed];
  drive -> control [style = dashed];
  drive -> remote [style = dashed];
  drive -> runjson;
  runjson -> live;
  live -> boot;
  boot -> start [label = "--break start"];
  boot -> schedule;
  start -> schedule;
  schedule -> ready;
  ready -> schedule [style = dotted, label = "continue"];
  ready -> teardown;
  schedule -> teardown;
  teardown -> exit;
}
