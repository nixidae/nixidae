// The states of one phase (`PhaseState`) and the code that moves a phase
// from one to the next. Every phase starts `pending`.
digraph states {
  rankdir = LR;
  node [shape = box, style = rounded];

  pending;
  running;
  // An end state of the scheduler. `ctl run` and a reload are in the key.
  node [peripheries = 2];
  passed;
  failed;
  unneeded;
  skipped;
  interrupted;
  deselected;
  node [peripheries = 1];

  // The code behind each edge, as a box beside the graph.
  key [shape = box, style = rounded, label = "Session.run: running and each end state\nskipped_by: the dependents of a failure\ncli.run: --only marks the rest deselected\nctl run: runs a phase again, from any state\nphases.reloaded: a reload keeps each state;\na new phase is pending, or deselected under --only", file = "pkgs/vivarium/vivarium/session.py", symbol = "Session.run"];

  pending -> running [label = "ready and launchable\n(_schedule), or ctl run"];
  running -> passed;
  running -> unneeded [label = "vms.skip(reason)"];
  running -> failed [label = "an exception"];
  running -> interrupted [label = "cancelled: ^C, signal, ctl stop"];
  pending -> skipped [label = "a phase in after failed"];
  pending -> deselected [label = "--only"];
}
