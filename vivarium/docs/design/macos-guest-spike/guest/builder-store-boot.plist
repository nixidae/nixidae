<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.nixidae.builder-store-boot</string>
    <!-- Union-mount the Nix Upper volume on /nix/store at boot. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/builder-store</string>
        <string>boot</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/builder-store.log</string>
</dict>
</plist>
