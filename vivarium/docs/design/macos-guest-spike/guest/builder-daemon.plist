<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.nixidae.builder-daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/vsockcat</string>
        <string>serve</string>
        <string>3030</string>
        <string>/nix/var/nix/profiles/default/bin/nix-daemon</string>
        <string>--stdio</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/builder-daemon.log</string>
</dict>
</plist>
