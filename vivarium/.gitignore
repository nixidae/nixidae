# Default-deny at the top level: a new file or directory here stays
# untracked until it is named below.
/*
!/.gitignore
!/.mcp.json
!/LICENSE
!/README.md
!/ci/
!/claude-plugin/
!/default.nix
!/docs/
!/examples/
!/flake.lock
!/flake.nix
!/images.nix
!/lib.nix
!/modules/
!/nix/
!/nixos-test.nix
!/pkgs/
!/recipes/
!/ruff.toml
!/run.sh
!/skill/
!/tests/

result*
# Throwaway experiments; see spike/default.nix.
/spike/
__pycache__/
