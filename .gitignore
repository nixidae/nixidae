# Default-deny. Nothing is tracked unless it is whitelisted below, so a draft,
# a scratch file or a sibling checkout can never reach the index by accident.
#
# kr8s, containerd and flake-compatish are not on the list: a checkout of one
# of them sits here, ignored, and takes the place of its pin.
/*
!/.gitignore
!/.envrc
!/.github/
!/CLAUDE.md
!/LICENSE
!/README.md
!/default.nix
!/flake.nix
!/flake.lock
!/shell.nix
!/nix/
!/pkgs/

# The sources. josh exports each one to its own repository.
!/dotgithub/
!/easykubenix/
!/ghanix/
!/havsorm/
!/huggorm/
!/kappy/
!/nanopynix/
!/nixkube/
!/pydd/
!/pynixd/
!/vivarium/

# Only the committed settings live under .claude; everything else there is
# agent state.
!/.claude/
/.claude/*
!/.claude/settings.json

# Local state, wherever it appears inside a whitelisted directory.
__pycache__/
.direnv/
